# Copie en .env pour le développement local. NE JAMAIS committer le .env réel.

ENVIRONMENT=dev
API_PREFIX=/api/v1
# Crée tables + données de base au démarrage (idempotent). true par défaut.
SEED_ON_STARTUP=true

# PostgreSQL local (ex. docker run postgres:16-alpine)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=toilettage
POSTGRES_USER=toilettage
POSTGRES_PASSWORD=change-me-locally

# CORS (origines du frontend)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Zone de service (Place du Martroi, Orléans)
SERVICE_CENTER_LAT=47.9027
SERVICE_CENTER_LNG=1.9086
SERVICE_RADIUS_KM=10
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=toilettage-orleans-dev/1.0 (contact: dev@example.com)

# Agenda
WORK_START_HOUR=9
WORK_END_HOUR=18
TRAVEL_BUFFER_MINUTES=30
SLOT_GRANULARITY_MINUTES=15

# Email (SMTP SORIA pour les tests) — laisser vide pour désactiver l'envoi en dev
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
GROOMER_NOTIFICATION_EMAIL=

# Keycloak (realm dédié)
KEYCLOAK_URL=https://keycloak.soria-academie.fr
KEYCLOAK_REALM=toilettage
KEYCLOAK_CLIENT_ID=toilettage-admin
